# Core
APP_ENV=development
SECRET_KEY=change_me_in_production_at_least_32_chars

# Database
DATABASE_URL=postgresql+asyncpg://zenith:zenith@db:5432/zenith
SYNC_DATABASE_URL=postgresql+psycopg2://zenith:zenith@db:5432/zenith

# Redis
REDIS_URL=redis://redis:6379/0

# Worker (API calls this for crawls / shopping compare).
# - API inside Docker Compose: compose sets WORKER_URL=http://worker-api:8001 (do not rely on this line).
# - API running on your machine (uvicorn): use http://127.0.0.1:8001 and run the worker on port 8001.
WORKER_URL=http://127.0.0.1:8001

# Optional FinCrawler — Yahoo Finance / TradeTalk crawl service on Render (same POST /crawl family as worker `main.py`).
# See docs/fincrawler-contract.md for tiered crawl API.
# FINCRAWLER_BASE_URL=https://your-crawler.onrender.com
# FINCRAWLER_CRAWL_PATH=/crawl
# FINCRAWLER_API_KEY=
# FINCRAWLER_TIMEOUT_SECONDS=300
# FINCRAWLER_SHOP_MAX_CONCURRENCY=5
# SHOP_STREAM_PER_RETAILER_TIMEOUT_SEC=90
# FINCRAWLER_QUOTE_PATH=/quote/full
# FINCRAWLER_QUOTE_TIMEOUT_SECONDS=300
# FinCrawler tiered crawl
# FINCRAWLER_DEFAULT_MAX_TIER=4
# FINCRAWLER_AUTO_ESCALATE=true
# FINCRAWLER_SESSION_WARM=true
# FINCRAWLER_PROXY_URL=
# FINCRAWLER_BEHAVIOR_SIM=true
# FINCRAWLER_CLIENT_MAX_ESCALATIONS=2
# FINCRAWLER_RETRY_ATTEMPTS=2

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Provider stubs (set to "sandbox" to use stub mode)
PLAID_CLIENT_ID=sandbox
PLAID_SECRET=sandbox
PLAID_ENV=sandbox

AWARDWALLET_CLIENT_ID=stub
AWARDWALLET_CLIENT_SECRET=stub
AWARDWALLET_ENV=stub

MX_CLIENT_ID=stub
MX_API_KEY=stub
MX_ENV=stub

YODLEE_CLIENT_ID=stub
YODLEE_SECRET=stub
YODLEE_ENV=stub

# Storage (local mode)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/tmp/zenith-evidence
